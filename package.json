{
  "name": "deepseek-desktop",
  "version": "1.4.2",
  "description": "DeepSeek Harness 桌面版 —— 以 dsh 为内核的 Windows 桌面应用",
  "main": "src/main/index.js",
  "author": "EasyTZ",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "icon": "node scripts/gen-icon.mjs",
    "install-plugin": "node scripts/install-plugin.mjs",
    "link-plugins": "node scripts/link-plugins.mjs",
    "unlink-plugins": "node scripts/link-plugins.mjs --off",
    "plugins-status": "node scripts/link-plugins.mjs --status",
    "refresh-plugins": "node scripts/refresh-plugins.mjs",
    "prepare-kernel": "node scripts/prepare-kernel.mjs",
    "dist": "node scripts/dist.mjs",
    "dist:dir": "node scripts/dist.mjs --dir",
    "verify-kernel": "node scripts/verify-kernel.mjs",
    "pack-kernel": "node scripts/pack-kernel.mjs",
    "pack-plugins": "node scripts/pack-plugins.mjs"
  },
  "dependencies": {
    "dsh-git": "github:EasyTZ/dsh-git#v0.2.1",
    "dsh-reveal-explorer": "github:EasyTZ/dsh-reveal-explorer#v0.1.1",
    "dsh-terminal-panel": "github:EasyTZ/dsh-terminal-panel#v0.1.1",
    "dsh-ui-balance": "github:EasyTZ/dsh-ui-balance#v0.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2"
  }
}
