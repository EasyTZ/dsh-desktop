# Electron / electron-builder 的二进制镜像配置。
# 注意：这两个 key 不写进 .npmrc（npm 10+ 会警告 unknown config），
# 需要用镜像时以环境变量形式传入：
#   $env:ELECTRON_MIRROR="https://npmmirror.com/mirrors/electron/"
#   $env:ELECTRON_BUILDER_BINARIES_MIRROR="https://npmmirror.com/mirrors/electron-builder-binaries/"

# 本仓库把 dsh 插件当 git 依赖 vendor 进来，只为拿到源码（拷进内核、打进安装包），
# 插件真正的 peer（cordis / dsh-*）由内核运行时提供，不在这里解析。四个插件之间
# 的 peer 范围有真实冲突（dsh-ui-balance 的 ^0.1.0-rc.7 vs dsh-workspace 闭包的
# ^0.1.1-rc.2），且 npm 自动装 peer 会把整棵内核依赖树拖进根 node_modules——
# 这两点都违背 vendor 语义，所以整仓库按 npm 3-6 语义忽略 peer 解析。
legacy-peer-deps=true
